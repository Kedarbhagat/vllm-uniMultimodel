# Copy to auth/.env and replace every placeholder before starting the server.
# Never commit auth/.env.
SESSION_SECRET_KEY=replace-with-a-long-random-secret
DATABASE_URL=postgresql://USER:PASSWORD@localhost:5432/LLMNET
GOOGLE_CLIENT_ID=your-google-oauth-client-id
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
ALLOWED_DOMAIN=nmit.ac.in
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:9096

# PostgreSQL settings used by RAG/dbhelper.py for threads and chat messages.
POSTGRES_DB=LLMNET
POSTGRES_USER=postgres
POSTGRES_PASSWORD=replace-with-your-postgres-password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# API key accepted by your vLLM OpenAI-compatible server. Keep the configured
# key aligned with the vLLM server; for a no-auth local server use a placeholder.
YOUR_API_KEY=token-abc123
LLAMA_API_URL=http://127.0.0.1:8000
DEEPSEEK_API_URL=http://127.0.0.1:8002
GPT_OSS_API_URL=http://127.0.0.1:8004
